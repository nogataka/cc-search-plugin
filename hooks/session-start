#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

# Read stdin (hook input JSON) and pass to inject-context CLI
# Plain text stdout is automatically added to Claude's context
cat | node "${PLUGIN_ROOT}/dist/cli.js" inject-context 2>/dev/null || true
